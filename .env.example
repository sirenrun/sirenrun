# Copy to .env.local (app) or export in your shell (scripts). Never commit real values.

# Cluster the scripts talk to: devnet (default) or local (scripts/local-up.sh).
SIRENRUN_CLUSTER=devnet

# Ephemeral rollup region: as (default) or eu. Accounts must be delegated to the same one.
NEXT_PUBLIC_ER_REGION=as

# Optional base-layer RPC override, e.g. a private devnet RPC to avoid rate limits.
NEXT_PUBLIC_BASE_RPC=

# Scripts only. Admin wallet: config admin, tUSDC mint authority and house.
# Defaults to ~/.config/solana/id.json.
SIRENRUN_ADMIN_KEYPAIR=

# Scripts only. tUSDC mint printed by create-mint (see docs/devnet.md).
SIRENRUN_MINT=
