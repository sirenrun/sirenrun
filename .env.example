# Copy to .env.local (app) or export in your shell (scripts). Never commit real values.

# Cluster the scripts talk to: devnet (default) or local (scripts/local-up.sh).
SIRENRUN_CLUSTER=devnet

# Ephemeral rollup region: as (default) or eu. Accounts must be delegated to the same one.
NEXT_PUBLIC_ER_REGION=as

# Optional base-layer RPC override, e.g. a private devnet RPC to avoid rate limits.
NEXT_PUBLIC_BASE_RPC=

# Scripts only. Admin wallet: config admin, tUSDC mint authority and house.
# Defaults to ~/.config/solana/id.json.
SIRENRUN_ADMIN_KEYPAIR=

# Scripts only. tUSDC mint printed by create-mint (see docs/devnet.md).
SIRENRUN_MINT=

# Scripts only. Faucet key file; once set-faucet has run it is the tUSDC mint authority.
SIRENRUN_FAUCET_KEYPAIR=

# App server only (the /api/faucet route). The faucet key's JSON byte array, exactly as
# solana-keygen writes it. Never the admin key. Leave empty to disable the faucet.
FAUCET_SECRET_KEY=

# Stats (indexer worker and app stats routes). Postgres URL; server only, never NEXT_PUBLIC_.
DATABASE_URL=

# Indexer only. Most transactions to walk back on start (default 6000).
INDEXER_MAX_BACKFILL=

# Indexer tests only. A throwaway database the test suite may wipe. Never production.
TEST_DATABASE_URL=
